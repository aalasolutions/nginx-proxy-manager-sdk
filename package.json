{
  "name": "nginx-proxy-manager-sdk",
  "version": "0.1.1",
  "description": "TypeScript SDK for Nginx Proxy Manager API. Programmatic proxy host management, SSL provisioning, and DNS verification.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "nginx",
    "proxy",
    "nginx-proxy-manager",
    "ssl",
    "letsencrypt",
    "reverse-proxy",
    "sdk"
  ],
  "author": "AALA Solutions (https://aalasolutions.com)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aalasolutions/nginx-proxy-manager-sdk.git"
  },
  "homepage": "https://github.com/aalasolutions/nginx-proxy-manager-sdk#readme",
  "bugs": {
    "url": "https://github.com/aalasolutions/nginx-proxy-manager-sdk/issues"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
